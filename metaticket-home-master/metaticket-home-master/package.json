{
  "name": "mt-ticket",
  "version": "3.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0",
    "startDev": "ng serve --host 0.0.0.0 --configuration dev",
    "start:local": "ng serve --host 127.0.0.1 --port 4200 --configuration local",
    "build": "ng build",
    "build:staging": "ng build --configuration staging",
    "build:production": "ng build --configuration production",
    "docker:staging:local": "yarn build:staging && docker compose -f docker-compose.staging.local.yml build",
    "docker:staging:local:up": "yarn build:staging && docker compose -f docker-compose.staging.local.yml up -d --build",
    "watch": "ng build --watch --configuration dev",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:staged": "yarn lint-staged"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged",
    "pre-push": "yarn build"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.2.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/platform-server": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^17.3.17",
    "@ckeditor/ckeditor5-angular": "^7.0.1",
    "@ckeditor/ckeditor5-build-classic": "^40.2.0",
    "@ckeditor/ckeditor5-core": "^40.2.0",
    "@ckeditor/ckeditor5-engine": "^40.2.0",
    "@ckeditor/ckeditor5-utils": "^40.2.0",
    "@ckeditor/ckeditor5-watchdog": "^40.2.0",
    "@ctrl/tinycolor": "^4.2.0",
    "@datorama/akita": "^8.0.1",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "hammerjs": "^2.0.8",
    "jwt-decode": "^4.0.0",
    "libphonenumber-js": "^1.12.8",
    "ng-hcaptcha": "2.7.0",
    "ng-recaptcha": "^13.2.1",
    "ng-zorro-antd": "^17.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.8",
    "@angular-eslint/builder": "17.1.1",
    "@angular-eslint/eslint-plugin": "17.1.1",
    "@angular-eslint/eslint-plugin-template": "17.1.1",
    "@angular-eslint/schematics": "17.1.1",
    "@angular-eslint/template-parser": "17.1.1",
    "@angular/cli": "^17.0.8",
    "@angular/compiler-cli": "^17.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "6.13.1",
    "@typescript-eslint/parser": "6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "fast-check": "3.23.2",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "simple-git-hooks": "^2.9.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.2.2"
  }
}
