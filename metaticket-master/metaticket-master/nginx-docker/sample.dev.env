CUSTOMER_USER_BACKEND_CONNECT_PORT=14050

CUSTOMER_AUTH_BACKEND_LISTEN_PORT=4051
CUSTOMER_AUTH_BACKEND_CONNECT_PORT=14051

# ~~~ gRPC ports ~~~
# LISTEN_PORT = the actual gRPC server port from each service's application.conf
# CONNECT_PORT = host-exposed port that nginx listens on and proxies to LISTEN_PORT
# (local -> host.docker.internal, remote -> dev server). Convention: CONNECT = LISTEN + 10000.

SHOW_GRPC_LISTEN_PORT=4103
SHOW_GRPC_CONNECT_PORT=14103

TICKET_GRPC_LISTEN_PORT=4104
TICKET_GRPC_CONNECT_PORT=14104

ORDER_GRPC_LISTEN_PORT=4105
ORDER_GRPC_CONNECT_PORT=14105

