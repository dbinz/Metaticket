TICKETSLOT_BACKEND_LISTEN_PORT=4009
TICKETSLOT_BACKEND_CONNECT_PORT=14009

QRCODE_BACKEND_LISTEN_PORT=4010
QRCODE_BACKEND_CONNECT_PORT=14010

