NGINX_ENVSUBST_TEMPLATE_SUFFIX=.tpl

METATICKET_REMOTE=10.0.1.12
# Host header for remote *.remote templates when METATICKET_REMOTE is an IP (staging server_name)
METATICKET_REMOTE_HOST=staging.metaticket.vn
METATICKET_LOCAL=host.docker.internal

# Port that browser connects to to access the nginx inside docker
NGINX_CONNECT_PORT=443
# Port that the nginx inside docker is listening to
NGINX_LISTEN_PORT=443

# Use in local config to proxy to local service
# Connect port are port
# Not use, the portal is accessed through /api path of the nginx,
# so services doesn't connect to it directly
MONGO_LISTEN_PORT=47017
MONGO_CONNECT_PORT=47018
KAFKA_LISTEN_PORT=4092
KAFKA_CONNECT_PORT=14092
REDIS_LISTEN_PORT=4379
REDIS_CONNECT_PORT=14379

EDITOR_POLICYDESC_BACKEND_LISTEN_PORT=4011
EDITOR_POLICYDESC_BACKEND_CONNECT_PORT=14011

EDITOR_SEATPLANNER_BACKEND_LISTEN_PORT=4012
EDITOR_SEATPLANNER_BACKEND_CONNECT_PORT=14012

HOMEPAGE_API_BACKEND_LISTEN_PORT=48080
HOMEPAGE_API_BACKEND_CONNECT_PORT=18080

WORDPRESS_LISTEN_PORT=8081
WORDPRESS_CONNECT_PORT=18081

NEWS_BACKEND_LISTEN_PORT=8082
NEWS_BACKEND_CONNECT_PORT=18082

SHOW_BACKEND_LISTEN_PORT=4003
SHOW_BACKEND_CONNECT_PORT=14003

TICKET_BACKEND_LISTEN_PORT=4004
TICKET_BACKEND_CONNECT_PORT=14004

ORDER_BACKEND_LISTEN_PORT=4005
