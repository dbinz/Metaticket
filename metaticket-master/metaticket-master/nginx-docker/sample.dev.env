# ~~~ gRPC config selectors ~~~
# Value = template file name (without .conf.tpl). Use *.grpc.local to route to a
# locally-running service, *.grpc.remote to route to the dev server.
CONF_SHOW_GRPC=show.grpc.remote
CONF_TICKET_GRPC=ticket.grpc.remote
