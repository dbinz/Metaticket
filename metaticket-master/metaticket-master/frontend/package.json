{
  "name": "frontend",
  "version": "1.0.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "dotenv -e .env.localhost next dev",
    "dev:devlocal": "dotenv -e .env.devlocal next dev",
    "dev:staging": "dotenv -e .env.staging next dev",
    "dev:prod": "dotenv -e .env.prod next dev",
    "build": "next build",
    "build:local": "dotenv -e .env.localhost next build",
    "build:devlocal": "dotenv -e .env.devlocal next build",
    "build:staging": "dotenv -e .env.staging next build",
    "build:prod": "dotenv -e .env.prod next build",
    "docker:staging": "docker build --build-arg env=staging -t staging/metaticket/frontend .",
    "docker:prod": "docker build --build-arg env=prod -t metaticket/frontend .",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
