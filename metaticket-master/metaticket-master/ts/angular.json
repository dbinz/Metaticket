{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "packages/lib",
    "projects": {
        "@metaticket/portal.admin": {
            "root": "packages/portal/metaticket/portal.admin",
            "sourceRoot": "packages/portal/metaticket/portal.admin/src",
            "prefix": "app",
            "projectType": "application",
            "architect": {
                "build": {
                    "builder": "ngx-build-plus:browser",
                    "options": {
                        "preserveSymlinks": true,
                        "outputPath": "dist/metaticket/portal.admin",
                        "index": "packages/portal/metaticket/portal.admin/src/index.html",
                        "main": "packages/portal/metaticket/portal.admin/src/main.ts",
                        "tsConfig": "packages/portal/metaticket/portal.admin/tsconfig.app.json",
                        "polyfills": [],
                        "extraWebpackConfig": "packages/portal/metaticket/portal.admin/webpack.config.js",
                        "commonChunk": false,
                        "assets": [
                            "packages/portal/metaticket/portal.admin/src/assets",
                            "packages/portal/metaticket/portal.admin/src/favicon.ico",
                            "packages/portal/metaticket/portal.admin/src/favicon.png",
                            {
                                "glob": "**/*",
                                "input": "node_modules/leaflet/dist/images",
                                "output": "/assets/img/markers"
                            }
                        ],
                        "styles": [
                            "node_modules/bootstrap/dist/css/bootstrap.css",
                            "node_modules/typeface-exo/index.css",
                            "node_modules/roboto-fontface/css/roboto/roboto-fontface.css",
                            "node_modules/@fortawesome/fontawesome-free/css/all.css",
                            "node_modules/socicon/css/socicon.css",
                            "node_modules/eva-icons/style/scss/eva-icons.scss",
                            "node_modules/pace-js/templates/pace-theme-flash.tmpl.css",
                            "packages/portal/metaticket/portal.admin/src/app/@theme/styles/styles.scss"
                        ],
                        "scripts": [
                            "node_modules/pace-js/pace.min.js",
                            "node_modules/tinymce/tinymce.min.js",
                            "node_modules/tinymce/themes/modern/theme.min.js",
                            "node_modules/tinymce/plugins/link/plugin.min.js",
                            "node_modules/tinymce/plugins/paste/plugin.min.js",
                            "node_modules/tinymce/plugins/table/plugin.min.js",
                            "node_modules/echarts/dist/echarts.min.js",
                            "node_modules/echarts/dist/extension/bmap.min.js",
                            "node_modules/chart.js/dist/Chart.min.js"
                        ],
                        "allowedCommonJsDependencies": [
                            "axios",
                            "angular2-chartjs",
                            "echarts",
                            "lodash",
                            "zrender/lib/svg/svg",
                            "zrender/lib/vml/vml"
                        ],
                        "vendorChunk": true,
                        "extractLicenses": false,
                        "buildOptimizer": false,
                        "sourceMap": true,
                        "optimization": false,
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "packages/portal/metaticket/portal.admin/src"
                            ]
                        },
                        "namedChunks": true
                    },
                    "configurations": {
                        "devlocal": {
                            "budgets": [
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb"
                                }
                            ],
                            "optimization": false,
                            "outputHashing": "none",
                            "sourceMap": true,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": false
                        },
                        "production": {
                            "budgets": [
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": false,
                            "vendorChunk": true,
                            "buildOptimizer": true,
                            "fileReplacements": [
                                {
                                    "replace": "packages/portal/metaticket/portal.admin/src/environments/environment.ts",
                                    "with": "packages/portal/metaticket/portal.admin/src/environments/environment.prod.ts"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": "devlocal"
                },
                "serve": {
                    "builder": "ngx-build-plus:dev-server",
                    "options": {
                        "browserTarget": "@metaticket/portal.admin:build:devlocal",
                        "extraWebpackConfig": "packages/portal/metaticket/portal.admin/webpack.config.js"
                    },
                    "configurations": {
                        "production": {
                            "browserTarget": "@metaticket/portal.admin:build:production"
                        },
                        "devlocal": {
                            "browserTarget": "@metaticket/portal.admin:build:devlocal"
                        }
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "packages/portal/metaticket/portal.admin/src/**/*.ts",
                            "packages/portal/metaticket/portal.admin/src/**/*.html"
                        ]
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ],
                        "tsConfig": "packages/portal/metaticket/portal.admin/tsconfig.spec.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [],
                        "styles": [],
                        "scripts": []
                    }
                }
            }
        },
