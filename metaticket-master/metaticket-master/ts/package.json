        "@nebular/auth": "^12.0.0",
        "@nebular/eva-icons": "^12.0.0",
        "@nebular/security": "^11.0.1",
        "@nebular/theme": "^11.0.1",
        "@swimlane/ngx-charts": "^14.0.0",
        "@types/bezier-js": "^4.1.0",
        "angular-favicon": "^1.0.9",
        "angular2-chartjs": "^0.5.1",
        "angular2-multiselect-dropdown": "^5.0.4",
