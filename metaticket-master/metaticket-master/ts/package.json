        "ngx-echarts": "^4.2.2",
        "normalize.css": "6.0.0",
        "pace-js": "1.0.2",
        "postcss": "^8.4.32",
        "qr-scanner": "^1.4.2",
        "remove-accents": "^0.5.0",
        "roboto-fontface": "^0.10.0",
        "rxjs": "~7.8.1",
        "rxjs-compat": "^6.6.7",
        "socicon": "^3.0.5",
        "style-loader": "^3.3.3",
        "tailwindcss": "^3.4.0",
        "tinymce": "4.5.7",
        "tslib": "^2.6.2",
        "typeface-exo": "^1.1.13",
        "web-animations-js": "^2.3.2",
        "webpack": "5.74.0",
        "zone.js": "^0.14.2"
    },
    "workspaces": [
        "dist/metaticket/*",
        "local_modules/viclass/*",
        "packages/themes/viclass/themes"
    ],
