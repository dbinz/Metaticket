{
    "name": "metaticket",
    "version": "3.1.0",
    "scripts": {
        "lint": "ng lint",
        "serve": "npx webpack serve --config ./packages/webpack/webpack.serve.js",
        "editor.common:build": "ng build @metaticket/editor.common",
        "editor.policydesc:build": "ng build @metaticket/editor.policydesc",
        "editor.seatplanner:build": "ng build @metaticket/editor.seatplanner",
        "editor:build": "yarn editor.common:build & yarn conc 'yarn:editor.policydesc:build' 'yarn:editor.seatplanner:build'",
        "editor.seatplanner.ui.style:build": "npx tailwindcss -c ./packages/lib/metaticket/editor.seatplanner.ui/tailwind.config.js -o ./packages/lib/metaticket/editor.seatplanner.ui/assets/tailwindcss.scss",
        "editor.seatplanner.ui:build": "ng build @metaticket/editor.seatplanner.ui",
        "editor.ui:build": "yarn editor.seatplanner.ui.style:build & yarn editor.seatplanner.ui:build",
        "mfe.container:build": "ng build @metaticket/mfe",
        "mfe.container-style:build": "cd ./packages/mfe/metaticket/mfe && npx webpack --config ./webpack.style.js",
        "mfe:build": "yarn conc 'yarn:mfe.container:build' 'yarn:mfe.container-style:build'",
        "ww:build-local": "cd ./packages/ww/metaticket/ww && npx webpack --config ./webpack.local.js",
        "ww:build": "cd ./packages/ww/metaticket/ww && npx webpack --config ./webpack.default.js",
        "build": "yarn editor:build & yarn editor.ui:build & yarn ww:build & yarn mfe:build",
        "portal.order.datacollector:build-local": "ng build @metaticket/portal.order.datacollector --configuration=local",
        "portal.order.datacollector:build": "ng build @metaticket/portal.order.datacollector",
        "portal.seatplanner:build": "ng build @metaticket/portal.seatplanner",
        "portal.admin:lint": "ng lint @metaticket/portal.admin",
        "portal.admin:format": "prettier --write \"packages/portal/metaticket/portal.admin/src/**/*.{ts,html,scss,css,json}\"",
        "portal.admin:build": "ng build @metaticket/portal.admin",
        "portal.admin:start": "yarn portal.admin:build --host 127.0.0.1 --disable-host-check",
        "portal:build": "yarn portal.seatplanner:build & yarn portal.admin:build & yarn portal.order.datacollector:build",
        "editor.common:watch": "yarn editor.common:build --watch",
        "editor.policydesc:watch": "yarn editor.policydesc:build --watch",
        "editor.seatplanner:watch": "yarn editor.seatplanner:build --watch",
        "editor:watch": "yarn conc 'yarn:editor.policydesc:watch' 'yarn:editor.seatplanner:watch'",
        "editor.seatplanner.ui.style:watch": "yarn editor.seatplanner.ui.style:build --watch",
        "editor.seatplanner.ui:watch": "yarn editor.seatplanner.ui:build --watch",
        "editor.seatplanner.ui-style:watch": "yarn editor.seatplanner.ui.style:build --watch",
        "editor.ui:watch": "yarn editor.seatplanner.ui.style:watch & yarn editor.seatplanner.ui:watch",
        "mfe.container-style:watch": "yarn mfe.container-style:build --watch",
        "mfe.container:watch": "yarn mfe.container:build --watch",
        "mfe:watch": "yarn conc 'yarn:mfe.container:watch' 'yarn:mfe.container-style:watch'",
        "ww:watch-local": "yarn ww:build-local --watch",
        "ww:watch": "yarn ww:build --watch",
        "portal.order.datacollector:watch-local": "yarn portal.order.datacollector:build-local --watch",
        "portal.order.datacollector:watch": "yarn portal.order.datacollector:build --watch",
        "portal.seatplanner:watch": "yarn portal.seatplanner:build --watch",
        "portal.admin:watch": "yarn portal.admin:build --watch",
        "editor.common:dist": "ng build @metaticket/editor.common --configuration=production",
        "editor.policydesc:dist": "ng build @metaticket/editor.policydesc --configuration=production",
        "editor.seatplanner:dist": "ng build @metaticket/editor.seatplanner --configuration=production",
        "editor:dist": "yarn editor.common:dist & yarn conc 'yarn:editor.policydesc:dist' 'yarn:editor.seatplanner:dist'",
        "editor.seatplanner.ui.style:dist": "npx tailwindcss -c ./packages/lib/metaticket/editor.seatplanner.ui/tailwind.config.js -o ./packages/lib/metaticket/editor.seatplanner.ui/assets/tailwindcss.scss --minify",
        "editor.seatplanner.ui:dist": "ng build @metaticket/editor.seatplanner.ui --configuration=production",
        "editor.ui:dist": "yarn editor.seatplanner.ui.style:dist & yarn editor.seatplanner.ui:dist",
        "mfe.container:dist": "ng build @metaticket/mfe --configuration=production",
        "mfe.container-style:dist": "cd ./packages/mfe/metaticket/mfe && npx webpack --config ./webpack.style.prod.js",
        "mfe:dist": "yarn conc 'yarn:mfe.container:dist' 'yarn:mfe.container-style:dist'",
        "ww:dist": "cd ./packages/ww/metaticket/ww && npx webpack --config ./webpack.prod.js",
        "dist": "yarn editor:dist & yarn editor.ui:dist & yarn ww:dist & yarn mfe:dist",
        "portal.order.datacollector:dist": "ng build @metaticket/portal.order.datacollector --configuration=production",
        "portal.seatplanner:dist": "ng build @metaticket/portal.seatplanner --configuration=production",
        "portal.admin:dist": "ng build @metaticket/portal.admin --configuration=production"
    },
    "private": true,
