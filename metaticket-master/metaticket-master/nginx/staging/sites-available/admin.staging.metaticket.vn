# Define upstreams for backend services
# Upstreams are defined in metaticket-upstream-server which is included in staging.metaticket.vn
# Since they are in the same http context, we don't need to include them again here.

#server {
#   listen 80;
#   server_name admin.staging.metaticket.vn 10.0.1.12;

#   location / {
#       return 301 https://$host$request_uri;
#   }
#}

server {
    listen 80;
    listen 443 ssl;
    listen [::]:443 ssl;

#     root /staging/metaticket/static/portal/portal.admin;
#     index index.html;

    server_name admin.staging.metaticket.vn 10.0.1.12;

    include /etc/nginx/metaticket-frags/ssl/admin.staging.metaticket.vn;

    # Gzip Configuration - Enhanced
    gzip on;
    gzip_types      text/plain application/xml application/javascript text/css application/json image/svg+xml; # Added more types
    gzip_proxied    no-cache no-store private expired auth;
    gzip_min_length 1000;

    # Internal location dùng để auth_request
    location = /internal/authenticate {
        internal;
        proxy_pass http://authentication_service/internal/authentication/check-login; # Using upstream
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization $http_authorization;
    }

    include /etc/nginx/metaticket-frags/metaticket-public-api;
    include /etc/nginx/metaticket-frags/metaticket-private-api;
    include /etc/nginx/metaticket-frags/metaticket-portal;
    include /etc/nginx/metaticket-frags/metaticket-modules;

    location / {
        root /staging/metaticket/static/portal/portal.admin;
        index index.html;
        add_header Access-Control-Allow-Origin *;
        try_files $uri $uri/ /index.html;
    }
}
