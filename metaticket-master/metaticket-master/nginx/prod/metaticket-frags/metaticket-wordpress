# ==========================================
# WORDPRESS (served on news.metaticket.com.vn)
# Requires http-level: include metaticket-limit-req-zones;
# ==========================================

location ~* ^/(?:wp-content|wp-includes)/.*\.php$ {
    deny all;
}

location ~ /\.(svn|git|env|ht) {
    deny all;
    access_log off;
    log_not_found off;
}

location = /xmlrpc.php {
    deny all;
}

location = /wp-login.php {
    limit_req zone=wp_login burst=5 nodelay;
    limit_req_status 429;

    proxy_pass http://127.0.0.1:8081/wp-login.php;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_read_timeout 120s;
    client_max_body_size 64m;
    proxy_hide_header X-Frame-Options;
    add_header Content-Security-Policy "frame-ancestors 'self' https://admin.metaticket.com.vn" always;
}

location / {
    proxy_pass http://127.0.0.1:8081/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_read_timeout 120s;
    client_max_body_size 64m;
    proxy_hide_header X-Frame-Options;
    add_header Content-Security-Policy "frame-ancestors 'self' https://admin.metaticket.com.vn" always;
    proxy_redirect ~^https://(?:admin|news)\.metaticket\.com\.vn/(wp-admin|wp-login\.php|wp-json|wp-content|wp-includes)(.*)$ https://news.metaticket.com.vn/$1$2;
    proxy_redirect ~^http://(?:admin|news)\.metaticket\.com\.vn/(wp-admin|wp-login\.php|wp-json|wp-content|wp-includes)(.*)$ https://news.metaticket.com.vn/$1$2;
    proxy_redirect ~^/(wp-admin|wp-login\.php|wp-json|wp-content|wp-includes)(.*)$ /$1$2;
}

# Direct WP REST bypasses BFF — keep off public edge (use /api/public/news/ instead)
location /api/public/wordpress/ {
    deny all;
}

# User enumeration: do NOT nginx-deny /wp/v2/users (breaks admin Add User / REST).
# Anonymous access blocked in mu-plugin rest_authentication_errors.
