[Unit]
Description=MetaTicket service.news
After=network.target

[Service]
Type=simple
User=metaticket
Group=metaticket
WorkingDirectory=/opt/metaticket/service/service.news
EnvironmentFile=-/etc/metaticket/service.news.env
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/opt/metaticket/service/service.news/bin/service.news
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
